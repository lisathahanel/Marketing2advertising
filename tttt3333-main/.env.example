# Production site origin (used for CORS allowlisting and canonical self-references)
APP_URL="https://marketing2advertising.com"

# Comma-separated list of additional permitted browser CORS origins
ALLOWED_ORIGINS="https://marketing2advertising.com,https://www.marketing2advertising.com"

# Local Express server port (Node dev / start only; Cloudflare Workers ignores this)
PORT="3000"

# Optional / Unused: Reserved if Gemini AI features are added later (never expose in VITE_* frontend env vars)
GEMINI_API_KEY=""
