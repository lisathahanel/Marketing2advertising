{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketing2advertising-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sw.js"]
  },
  "vars": {
    "APP_URL": "https://marketing2advertising-preview.lisathahanel.workers.dev",
    "ALLOWED_ORIGINS": "https://marketing2advertising-preview.lisathahanel.workers.dev"
  }
}
