{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketing2advertising-homepage-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "marketing2advertising.com/api/health", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/thumb*", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/nasa-video/*", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/offline-media/*", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/offline-pack", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/creator", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/videos*", "zone_name": "marketing2advertising.com" },
    { "pattern": "marketing2advertising.com/api/engagement/*", "zone_name": "marketing2advertising.com" }
  ],
  "vars": {
    "APP_URL": "https://marketing2advertising.com",
    "ALLOWED_ORIGINS": "https://marketing2advertising.com,https://www.marketing2advertising.com"
  }
}
