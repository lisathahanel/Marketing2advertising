# ==============================================================================
# QuantPulse All-in-One Trading Bot Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Execution mode:
#   paper   = Simulated trading with virtual balance (DEFAULT, zero risk)
#   testnet = Binance Spot Testnet (requires testnet.binance.vision keys)
#   live    = Real Binance Spot execution (REAL MONEY - test in paper/testnet first!)
MODE=paper

# Telegram Notifications (Get token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance API Keys (Required ONLY when MODE=testnet or MODE=live)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Markets & Timeframes to scan
CRYPTO_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT
FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,XAUUSD
TIMEFRAMES=15m,1H,4H

# Signal Sensitivity (2 = BUY/SELL and STRONG, 4 = STRONG BUY/SELL only)
MIN_SIGNAL_SCORE=2

# Risk Management & Paper Portfolio
PAPER_BALANCE_USDT=10000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_TRADES=3

# Continuous loop interval in seconds (ignored when running with --once)
SCAN_INTERVAL_SECONDS=60
